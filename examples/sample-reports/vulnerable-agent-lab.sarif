{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "intelligent-agent-security-auditor",
          "version": "1.0.0",
          "informationUri": "https://github.com/titoparra4/intelligent-agent-security-auditor",
          "rules": [
            {
              "id": "ARCH-001",
              "name": "Arch001",
              "shortDescription": {
                "text": "Lethal combination: private data + untrusted content + external communication"
              },
              "fullDescription": {
                "text": "The same agent context can (1) read sensitive data, (2) ingest attacker-controllable content and (3) communicate externally. Any successful indirect prompt injection can chain these into data exfiltration without a software vulnerability."
              },
              "help": {
                "text": "Break the combination: remove one leg or isolate it. Run untrusted-content processing in a quarantined context without sensitive tools, require human approval for egress, and enforce a destination allowlist outside the model.",
                "markdown": "**Remediation:** Break the combination: remove one leg or isolate it. Run untrusted-content processing in a quarantined context without sensitive tools, require human approval for egress, and enforce a destination allowlist outside the model."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M01",
                  "Data Leakage",
                  "ASI01:2026",
                  "ASI02:2026",
                  "LLM01:2026",
                  "LLM02:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "AUTO-001",
              "name": "Auto001",
              "shortDescription": {
                "text": "Irreversible or destructive action without human approval"
              },
              "fullDescription": {
                "text": "A tool that sends, deletes, pays, deploys or executes can be invoked without an approval step enforced outside the model."
              },
              "help": {
                "text": "Enforce human approval in the tool runtime (not in the prompt) for irreversible operations; show the full action and parameters to the approver.",
                "markdown": "**Remediation:** Enforce human approval in the tool runtime (not in the prompt) for irreversible operations; show the full action and parameters to the approver."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M09",
                  "Agent Autonomy",
                  "ASI02:2026",
                  "ASI09:2026",
                  "LLM03:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "AUTO-002",
              "name": "Auto002",
              "shortDescription": {
                "text": "No iteration / step limit"
              },
              "fullDescription": {
                "text": "No maximum number of turns/iterations/recursion was found for the agent loop."
              },
              "help": {
                "text": "Set explicit max turns/iterations and per-run tool-call limits.",
                "markdown": "**Remediation:** Set explicit max turns/iterations and per-run tool-call limits."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M09",
                  "Agent Autonomy",
                  "ASI08:2026",
                  "LLM06:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "AUTO-004",
              "name": "Auto004",
              "shortDescription": {
                "text": "No budget or consumption limit"
              },
              "fullDescription": {
                "text": "No spending/token/rate budget was declared for the agent."
              },
              "help": {
                "text": "Declare and enforce token/cost/rate budgets per run and per day.",
                "markdown": "**Remediation:** Declare and enforce token/cost/rate budgets per run and per day."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M09",
                  "Agent Autonomy",
                  "ASI08:2026",
                  "LLM06:2026"
                ],
                "security-severity": "2.0"
              }
            },
            {
              "id": "AUTO-005",
              "name": "Auto005",
              "shortDescription": {
                "text": "No kill switch / interruption mechanism declared"
              },
              "fullDescription": {
                "text": "No mechanism to stop or disable the agent at runtime was declared."
              },
              "help": {
                "text": "Implement and document a kill switch (feature flag, credential revocation, queue pause).",
                "markdown": "**Remediation:** Implement and document a kill switch (feature flag, credential revocation, queue pause)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M09",
                  "Agent Autonomy",
                  "ASI10:2026",
                  "ASI08:2026"
                ],
                "security-severity": "2.0"
              }
            },
            {
              "id": "AUTO-006",
              "name": "Auto006",
              "shortDescription": {
                "text": "Approval required only by prompt instructions"
              },
              "fullDescription": {
                "text": "Instructions ask the model to request confirmation before sensitive actions, but no enforcement exists in the tool runtime."
              },
              "help": {
                "text": "Move the approval to code (approval gate / interrupt) that the model cannot bypass.",
                "markdown": "**Remediation:** Move the approval to code (approval gate / interrupt) that the model cannot bypass."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M09",
                  "Agent Autonomy",
                  "ASI09:2026",
                  "ASI02:2026",
                  "LLM03:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "DATA-002",
              "name": "Data002",
              "shortDescription": {
                "text": "Sensitive data or full model context written to logs"
              },
              "fullDescription": {
                "text": "Logging/print statements emit variables that likely contain secrets, personal data, full prompts, tool results or memory content."
              },
              "help": {
                "text": "Log identifiers and metadata, not content. Apply structured redaction before logging and set retention.",
                "markdown": "**Remediation:** Log identifiers and metadata, not content. Apply structured redaction before logging and set retention."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M03",
                  "Data Leakage",
                  "ASI03:2026",
                  "LLM02:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "DATA-003",
              "name": "Data003",
              "shortDescription": {
                "text": "Sensitive data can flow to an egress sink without control"
              },
              "fullDescription": {
                "text": "A tool that reads sensitive data and a tool/destination that sends data externally coexist in one agent, and the egress path has neither human approval nor a destination allowlist."
              },
              "help": {
                "text": "Require approval for egress tools, enforce a destination allowlist in the tool/backend, and apply DLP to outbound payloads.",
                "markdown": "**Remediation:** Require approval for egress tools, enforce a destination allowlist in the tool/backend, and apply DLP to outbound payloads."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M03",
                  "Data Leakage",
                  "ASI02:2026",
                  "ASI03:2026",
                  "LLM02:2026",
                  "LLM03:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "DATA-005",
              "name": "Data005",
              "shortDescription": {
                "text": "Cross-user / cross-tenant data access not isolated"
              },
              "fullDescription": {
                "text": "A data-access tool queries shared stores without evidence of user or tenant scoping in the query or the credential used."
              },
              "help": {
                "text": "Bind tool credentials and queries to the end-user identity (row-level security, per-tenant credentials, on-behalf-of tokens). Never rely on the model to filter tenants.",
                "markdown": "**Remediation:** Bind tool credentials and queries to the end-user identity (row-level security, per-tenant credentials, on-behalf-of tokens). Never rely on the model to filter tenants."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M03",
                  "Data Privacy",
                  "ASI03:2026",
                  "LLM02:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "EXF-001",
              "name": "Exf001",
              "shortDescription": {
                "text": "Unrestricted external destination"
              },
              "fullDescription": {
                "text": "The agent sends data to an external destination that is not in the policy/manifest allowlist (or no allowlist exists)."
              },
              "help": {
                "text": "Define an egress allowlist enforced by network policy or an egress proxy; remove or declare the destination; require approval for outbound transmissions.",
                "markdown": "**Remediation:** Define an egress allowlist enforced by network policy or an egress proxy; remove or declare the destination; require approval for outbound transmissions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M04",
                  "Network Security",
                  "ASI02:2026",
                  "LLM02:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "EXF-003",
              "name": "Exf003",
              "shortDescription": {
                "text": "Sensitive local collection capability"
              },
              "fullDescription": {
                "text": "Code accesses clipboard, camera, microphone, keystrokes, screenshots, browser profiles, SSH/cloud credential stores or harvests host information. This is a capability indicator, not proof of spyware."
              },
              "help": {
                "text": "Remove the capability or declare it explicitly (manifest + user disclosure) and scope it to the task.",
                "markdown": "**Remediation:** Remove the capability or declare it explicitly (manifest + user disclosure) and scope it to the task."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M04",
                  "Spyware & Malware",
                  "ASI10:2026",
                  "ASI02:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "MCP-001",
              "name": "Mcp001",
              "shortDescription": {
                "text": "MCP server package not version-pinned"
              },
              "fullDescription": {
                "text": "The MCP server is launched from a package registry or image without an exact version/digest, so every start may run different code (silent updates, rug pulls, typosquats)."
              },
              "help": {
                "text": "Pin exact versions (npx pkg@1.2.3, uvx pkg==1.2.3, image@sha256:...) and review updates before bumping.",
                "markdown": "**Remediation:** Pin exact versions (npx pkg@1.2.3, uvx pkg==1.2.3, image@sha256:...) and review updates before bumping."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M06",
                  "Supply Chain",
                  "ASI04:2026",
                  "LLM04:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "MCP-005",
              "name": "Mcp005",
              "shortDescription": {
                "text": "Tool poisoning indicators in MCP tool description"
              },
              "fullDescription": {
                "text": "An MCP tool description contains instructions aimed at the model (hidden tags, directives to read files, to call other tools, to conceal actions from the user, or to send data)."
              },
              "help": {
                "text": "Remove the server or the poisoned tool; pin and review tool definitions (description hashes) and show full descriptions to users at approval time.",
                "markdown": "**Remediation:** Remove the server or the poisoned tool; pin and review tool definitions (description hashes) and show full descriptions to users at approval time."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M06",
                  "API & MCP Security",
                  "ASI04:2026",
                  "ASI01:2026",
                  "LLM01:2026",
                  "LLM04:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "MCP-008",
              "name": "Mcp008",
              "shortDescription": {
                "text": "MCP server with filesystem or network scope beyond the task"
              },
              "fullDescription": {
                "text": "An MCP server is granted the whole filesystem / home directory or unrestricted fetch capability."
              },
              "help": {
                "text": "Restrict roots to the minimum project directories; for fetch-type servers enforce a URL allowlist and block private/metadata addresses.",
                "markdown": "**Remediation:** Restrict roots to the minimum project directories; for fetch-type servers enforce a URL allowlist and block private/metadata addresses."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M06",
                  "Identity & Access",
                  "ASI02:2026",
                  "ASI03:2026",
                  "LLM03:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "MCP-011",
              "name": "Mcp011",
              "shortDescription": {
                "text": "Untrusted or unknown MCP server source"
              },
              "fullDescription": {
                "text": "An MCP server is not marked as trusted in configuration/manifest and its provenance could not be established."
              },
              "help": {
                "text": "Inventory MCP servers, record owner/provenance and approval, and allow only reviewed servers.",
                "markdown": "**Remediation:** Inventory MCP servers, record owner/provenance and approval, and allow only reviewed servers."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M06",
                  "Supply Chain",
                  "ASI04:2026"
                ],
                "security-severity": "2.0"
              }
            },
            {
              "id": "MEM-001",
              "name": "Mem001",
              "shortDescription": {
                "text": "Persistent memory not isolated per user/tenant"
              },
              "fullDescription": {
                "text": "Long-term or vector memory is shared across users/tenants, or its scope is not established."
              },
              "help": {
                "text": "Partition memory by user/tenant (separate namespaces/collections with enforced filters) and bind access to the authenticated identity.",
                "markdown": "**Remediation:** Partition memory by user/tenant (separate namespaces/collections with enforced filters) and bind access to the authenticated identity."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M07",
                  "Memory Security",
                  "ASI06:2026",
                  "LLM02:2026",
                  "LLM09:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "MEM-002",
              "name": "Mem002",
              "shortDescription": {
                "text": "Memory without retention limit"
              },
              "fullDescription": {
                "text": "Persistent memory has no TTL/retention policy."
              },
              "help": {
                "text": "Define TTL/retention per data category and purge expired entries.",
                "markdown": "**Remediation:** Define TTL/retention per data category and purge expired entries."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M07",
                  "Data Privacy",
                  "ASI06:2026"
                ],
                "security-severity": "2.0"
              }
            },
            {
              "id": "MEM-003",
              "name": "Mem003",
              "shortDescription": {
                "text": "Untrusted content written to long-term memory without provenance"
              },
              "fullDescription": {
                "text": "Tool output or external content can be written to persistent memory without provenance tracking or validation."
              },
              "help": {
                "text": "Record provenance (source, trust level) for every memory write, block instruction-like content, and do not let untrusted sources write rules or preferences.",
                "markdown": "**Remediation:** Record provenance (source, trust level) for every memory write, block instruction-like content, and do not let untrusted sources write rules or preferences."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M07",
                  "Memory Security",
                  "ASI06:2026",
                  "LLM05:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "MEM-004",
              "name": "Mem004",
              "shortDescription": {
                "text": "Memory injected into system instructions"
              },
              "fullDescription": {
                "text": "Recalled memory is placed in the system/developer prompt, granting it instruction-level authority."
              },
              "help": {
                "text": "Inject memory as clearly delimited data in a lower-privilege message, never in the system prompt.",
                "markdown": "**Remediation:** Inject memory as clearly delimited data in a lower-privilege message, never in the system prompt."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M07",
                  "Memory Security",
                  "ASI06:2026",
                  "ASI01:2026",
                  "LLM01:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "MEM-005",
              "name": "Mem005",
              "shortDescription": {
                "text": "No memory deletion mechanism"
              },
              "fullDescription": {
                "text": "No mechanism to delete a user's memory entries was declared."
              },
              "help": {
                "text": "Provide per-user deletion (and per-entry deletion for poisoning response).",
                "markdown": "**Remediation:** Provide per-user deletion (and per-entry deletion for poisoning response)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M07",
                  "Data Privacy",
                  "ASI06:2026"
                ],
                "security-severity": "2.0"
              }
            },
            {
              "id": "PERM-001",
              "name": "Perm001",
              "shortDescription": {
                "text": "Excessive data permissions"
              },
              "fullDescription": {
                "text": "A tool's credential/scope grants broader access than the tool's operations require (least privilege violation)."
              },
              "help": {
                "text": "Request the narrowest scope that supports the tool's operations (e.g. drive.file or drive.readonly instead of drive; gmail.readonly instead of https://mail.google.com/).",
                "markdown": "**Remediation:** Request the narrowest scope that supports the tool's operations (e.g. drive.file or drive.readonly instead of drive; gmail.readonly instead of https://mail.google.com/)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M05",
                  "Identity & Access",
                  "ASI03:2026",
                  "ASI02:2026",
                  "LLM03:2026"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "PI-001",
              "name": "Pi001",
              "shortDescription": {
                "text": "Indirect prompt injection exposure via tool output"
              },
              "fullDescription": {
                "text": "A tool returns externally controllable content (email, documents, web, tickets, RAG) into the model context without a declared isolation mechanism (spotlighting/delimiting, quarantined LLM, content sanitization)."
              },
              "help": {
                "text": "Treat tool output as data: wrap it in explicit untrusted-content markers, strip/neutralize instruction-like content, process it in a quarantined sub-agent without privileged tools, and enforce authorization for follow-up tool calls outside the model.",
                "markdown": "**Remediation:** Treat tool output as data: wrap it in explicit untrusted-content markers, strip/neutralize instruction-like content, process it in a quarantined sub-agent without privileged tools, and enforce authorization for follow-up tool calls outside the model."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M02",
                  "Prompt Injection",
                  "ASI01:2026",
                  "LLM01:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "PI-003",
              "name": "Pi003",
              "shortDescription": {
                "text": "Instruction-like payload found in agent-reachable content"
              },
              "fullDescription": {
                "text": "Content stored in the project (fixtures, documents, emails, knowledge-base files, tool descriptions) contains text that tries to override instructions, spoof roles or trigger tools. It is evidence of poisoned or adversarial content reachable by the agent, not proof of exploitation."
              },
              "help": {
                "text": "Remove or quarantine the content; if it is an intentional test fixture, keep it under tests/ and exclude it from production corpora. Add ingestion-time scanning for instruction-like content.",
                "markdown": "**Remediation:** Remove or quarantine the content; if it is an intentional test fixture, keep it under tests/ and exclude it from production corpora. Add ingestion-time scanning for instruction-like content."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M02",
                  "Prompt Injection",
                  "ASI01:2026",
                  "ASI06:2026",
                  "LLM01:2026",
                  "LLM05:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "PI-004",
              "name": "Pi004",
              "shortDescription": {
                "text": "Encoded or hidden instructions in content"
              },
              "fullDescription": {
                "text": "Content contains hidden characters (zero-width / bidi controls), HTML comments or encoded blobs whose decoded form looks like instructions. These are common obfuscation techniques for injection payloads."
              },
              "help": {
                "text": "Normalize and strip invisible characters and comments at ingestion; decode-and-scan encoded content; reject documents with hidden instructions.",
                "markdown": "**Remediation:** Normalize and strip invisible characters and comments at ingestion; decode-and-scan encoded content; reject documents with hidden instructions."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M02",
                  "Prompt Injection",
                  "ASI01:2026",
                  "LLM01:2026"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "SUP-001",
              "name": "Sup001",
              "shortDescription": {
                "text": "Unpinned dependency"
              },
              "fullDescription": {
                "text": "A dependency is declared with a range or no version."
              },
              "help": {
                "text": "Pin exact versions in a lockfile (with hashes where supported).",
                "markdown": "**Remediation:** Pin exact versions in a lockfile (with hashes where supported)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M08",
                  "Supply Chain",
                  "ASI04:2026",
                  "LLM04:2026"
                ],
                "security-severity": "2.0"
              }
            },
            {
              "id": "SUP-002",
              "name": "Sup002",
              "shortDescription": {
                "text": "No lockfile"
              },
              "fullDescription": {
                "text": "Dependencies are declared but no lockfile (or hashed requirements) was found."
              },
              "help": {
                "text": "Commit a lockfile (uv.lock, poetry.lock, package-lock.json, pip-compile --generate-hashes).",
                "markdown": "**Remediation:** Commit a lockfile (uv.lock, poetry.lock, package-lock.json, pip-compile --generate-hashes)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "ai-agent",
                  "M08",
                  "Supply Chain",
                  "ASI04:2026",
                  "LLM04:2026"
                ],
                "security-severity": "2.0"
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "agent-security/ASSESSMENT-EXAMPLE"
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "DATA-005",
          "level": "error",
          "message": {
            "text": "[CONFIRMED/HIGH] Cross-user / cross-tenant data access not isolated \u2014 tool:crm_lookup. deployment.multi_user=true; tool tenant_scoped=False"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/agent.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 46
                }
              }
