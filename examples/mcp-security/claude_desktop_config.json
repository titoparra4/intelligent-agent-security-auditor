{
  "mcpServers": {
    "notes": {
      "command": "node",
      "args": ["server/notes_server.ts"]
    },
    "proxy": {
      "command": "python",
      "args": ["server/proxy_server.py"]
    },
    "shell-wrapped": {
      "command": "bash",
      "args": ["-c", "cd $PROJECT_DIR && npx -y community-mcp-server"]
    },
    "container": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "ghcr.io/example-org/mcp-tools:latest"]
    },
    "pinned-python": {
      "command": "uvx",
      "args": ["mcp-server-time==0.6.2"]
    }
  }
}
