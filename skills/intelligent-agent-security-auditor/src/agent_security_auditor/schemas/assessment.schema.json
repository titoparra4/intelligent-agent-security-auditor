{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/titoparra4/intelligent-agent-security-auditor/assets/schemas/assessment.schema.json",
  "title": "Agent Security Assessment",
  "description": "Complete result of one audit run (schema 1.0.0). Findings follow finding.schema.json (embedded below as $defs.finding).",
  "type": "object",
  "required": ["schema_version", "assessment_id", "tool", "target", "target_name", "mode", "started_at", "finished_at", "policy", "scope", "readiness", "score", "summary", "findings", "controls", "inventory", "permission_matrix", "data_flows", "delegation_graph", "threat_model", "test_plan", "test_results", "module_status", "dimension_coverage", "errors", "limitations", "disclaimer"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "assessment_id": {"type": "string", "minLength": 1},
    "tool": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "intelligent-agent-security-auditor"}, "version": {"type": "string"}}},
    "target": {"type": "string"},
    "target_name": {"type": "string"},
    "mode": {"type": "string", "enum": ["static", "threat-model", "dynamic", "ci"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "policy": {"type": "object", "required": ["name", "policy_version", "source", "sha256"]},
    "scope": {"type": "object", "required": ["files_scanned", "network_access", "executed_target_code"]},
    "readiness": {
      "type": "object",
      "required": ["verdict", "reasons", "blocking_findings", "failed_mandatory_controls", "unverified_mandatory_controls", "accepted_risks", "expired_exceptions", "scope_statement"],
      "properties": {
        "verdict": {"type": "string", "enum": ["READY", "READY_WITH_RISKS", "NOT_READY", "INSUFFICIENT_EVIDENCE"]},
        "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "blocking_findings": {"type": "array", "items": {"type": "string"}},
        "failed_mandatory_controls": {"type": "array", "items": {"type": "string"}},
        "unverified_mandatory_controls": {"type": "array", "items": {"type": "string"}},
        "accepted_risks": {"type": "array"},
        "expired_exceptions": {"type": "array"},
        "scope_statement": {"type": "string"}
      }
    },
    "score": {"type": "object", "required": ["score", "grade", "coverage_percent", "note"], "properties": {"score": {"type": "integer", "minimum": 0, "maximum": 100}, "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100}}},
    "summary": {"type": "object", "required": ["total_findings", "by_severity", "by_status"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "inventory": {"type": "object", "required": ["agents", "tools", "mcp_servers", "memory", "network", "dependencies", "delegations"]},
    "permission_matrix": {"type": "array", "items": {"type": "object", "required": ["tool", "identity", "permissions", "data_access", "operations", "risk", "required_approval", "permission_provenance"]}},
    "data_flows": {"type": "array"},
    "delegation_graph": {"type": "object"},
    "threat_model": {"type": "object"},
    "test_plan": {"type": "array", "items": {"type": "object", "required": ["test_id", "objective", "preconditions", "synthetic_input", "expected_behavior", "evidence", "result"]}},
    "test_results": {"type": "array"},
    "module_status": {"type": "array", "items": {"type": "object", "required": ["module", "name", "implementation", "ran"]}, "minItems": 12},
    "dimension_coverage": {"type": "array", "items": {"type": "object", "required": ["name", "relevance", "expected_controls"]}, "minItems": 15},
    "errors": {"type": "array"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "disclaimer": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": ["control_id", "title", "module", "kind", "status", "mandatory", "rationale", "evidence", "related_findings"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^CTRL-[A-Z]+-[0-9A-Z]+$"},
        "kind": {"type": "string", "enum": ["design", "behavioral"]},
        "status": {"type": "string", "enum": ["PASSED", "FAILED", "NOT_VERIFIED", "INSUFFICIENT_EVIDENCE", "NOT_APPLICABLE"]},
        "mandatory": {"type": "boolean"}
      }
    },
    "evidence_type": {"type": "string", "enum": ["code", "configuration", "declaration", "dependency_metadata", "content", "absence", "inference", "policy", "dynamic_trace"]},
    "evidence": {
      "type": "object",
      "required": ["type", "file", "line", "snippet", "note"],
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "#/$defs/evidence_type"},
        "file": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "snippet": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "display_id", "rule_id", "title", "description", "module", "category", "severity", "confidence", "status", "asset", "source_file", "source_line", "evidence", "evidence_type", "attack_preconditions", "impact", "likelihood", "affected_permissions", "trust_boundary", "owasp_references", "nist_references", "remediation", "verification_steps", "first_seen", "assessment_id"],
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string", "pattern": "^ASA-[0-9A-F]{12}$"},
        "display_id": {"type": "string", "pattern": "^(SEC-[0-9]{3,}|)$"},
        "rule_id": {"type": "string", "pattern": "^[A-Z]+-[0-9A-Z]+$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "module": {"type": "string", "pattern": "^M(0[1-9]|1[0-2])$"},
        "category": {"type": "string"},
        "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
        "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
        "status": {"type": "string", "enum": ["CONFIRMED", "POTENTIAL", "OBSERVATION", "NOT_VERIFIED"]},
        "asset": {"type": "string", "minLength": 1},
        "source_file": {"type": ["string", "null"]},
        "source_line": {"type": ["integer", "null"], "minimum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "evidence_type": {"$ref": "#/$defs/evidence_type"},
        "attack_preconditions": {"type": "array", "items": {"type": "string"}},
        "impact": {"type": "string"},
        "likelihood": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "affected_permissions": {"type": "array", "items": {"type": "string"}},
        "trust_boundary": {"type": ["string", "null"]},
        "owasp_references": {"type": "array", "items": {"type": "string"}},
        "nist_references": {"type": "array", "items": {"type": "string"}},
        "other_references": {"type": "array", "items": {"type": "string"}},
        "remediation": {"type": "string", "minLength": 1},
        "verification_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "requires_specialized_review": {"type": "boolean"},
        "accepted_risk": {"type": ["object", "null"]},
        "first_seen": {"type": "string"},
        "assessment_id": {"type": "string"}
      }
    }
  }
}
